package com.pedropathing.revhub.localizers;

import com.pedropathing.config.ConfigVar;
import com.pedropathing.config.Configuration;
import com.qualcomm.hardware.gobilda.GoBildaPinpointDriver;
import org.firstinspires.ftc.robotcore.external.navigation.DistanceUnit;

import java.util.OptionalDouble;

/**
 * Configurações do localizador goBILDA Pinpoint no Pedro Pathing.
 * - ConfigVar.required(): precisa ser definido na sua configuração.
 * - ConfigVar.of(valor): já tem um padrão, altere só se precisar.
 */
public class PinpointConfig {
    // ------------------ OBRIGATÓRIOS ------------------
    public final ConfigVar<String> name = ConfigVar.required();   // nome do Pinpoint no hardwareMap

    // Sentido de leitura de cada pod: X deve aumentar para frente e Y para a esquerda
    public final ConfigVar<GoBildaPinpointDriver.EncoderDirection> xPodDirection = ConfigVar.required();
    public final ConfigVar<GoBildaPinpointDriver.EncoderDirection> yPodDirection = ConfigVar.required();

    // Posição dos pods em relação ao centro de rotação do robô, na unidade offsetUnits
    public final ConfigVar<Double> xPodOffset = ConfigVar.required();   // deslocamento lateral do pod X (esquerda = +)
    public final ConfigVar<Double> yPodOffset = ConfigVar.required();   // deslocamento frontal do pod Y (frente = +)

    // ------------------ OPCIONAIS (com padrão) ------------------
    public final ConfigVar<DistanceUnit> offsetUnits = ConfigVar.of(DistanceUnit.INCH);

    /** Unidade de distância usada em todas as poses e posições */
    public final ConfigVar<DistanceUnit> globalDistanceUnit = ConfigVar.of(DistanceUnit.INCH);
    public final ConfigVar<DistanceUnit> encoderResolutionUnit = ConfigVar.of(DistanceUnit.INCH);   // unidade da resolução do encoder

    // Modelo do pod goBILDA (define a resolução padrão)
    public final ConfigVar<GoBildaPinpointDriver.GoBildaOdometryPods> podType = ConfigVar.of(GoBildaPinpointDriver.GoBildaOdometryPods.goBILDA_4_BAR_POD);

    // Resolução personalizada (ticks por unidade); vazio por padrão
    public final ConfigVar<OptionalDouble> ticksPerUnit = ConfigVar.of(OptionalDouble.empty());

    // Tipo de reset do Pinpoint; o padrão recalibra o IMU (mantenha o robô parado)
    public final ConfigVar<PinpointLocalizer.ResetMode> resetMode = ConfigVar.of(PinpointLocalizer.ResetMode.RECALIBRATE_IMU);

    // Aplica os valores definidos por quem cria a configuração
    public PinpointConfig(Configuration<PinpointConfig> config) {
        config.configure(this);
    }
}
